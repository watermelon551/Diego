# Required
LLM_API_STYLE=openai_chat
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Optional
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE_OUTLINE=0.3
LLM_TEMPERATURE_SLIDE=0.6
GENERATION_ENGINE=agentic_v2
SLIDE_CONCURRENCY=4
SLIDE_RETRY=2
QA_ENABLED=1
REPAIR_ROUNDS=2
MAX_SLIDE_REPAIR_ROUNDS=4
DEBUG_KEEP_PREVIEWS=0

# Template image/icon asset provider
ASSET_PROVIDER=mock
# For ASSET_PROVIDER=auto/unsplash
UNSPLASH_ACCESS_KEY=
# For ASSET_PROVIDER=auto/pexels
PEXELS_API_KEY=
ASSET_TIMEOUT_SEC=20
ASSET_MAX_RETRIES=2
