# =========================
# 必填项（必须配置）
# =========================

# 大模型 API 协议风格：openai_chat（OpenAI 兼容）或 anthropic_messages（Anthropic 风格）
LLM_API_STYLE=openai_chat

# 大模型服务基地址（不要带具体模型路径）
LLM_BASE_URL=https://api.minimaxi.com/v1

# 大模型服务密钥（请替换为你自己的真实密钥）
LLM_API_KEY=

# 默认使用的模型名称
LLM_MODEL=minimax-m2.7



# =========================
# 可选项（有默认值）
# =========================

# 单次 LLM 请求超时时间（秒）；网络慢时可适当调大（如 120）
LLM_TIMEOUT_SEC=300

# LLM 通用重试次数（非大纲超时重试）；越大越稳但耗时更长
LLM_MAX_RETRIES=2

# 大纲生成温度；越低越稳定，越高越发散
LLM_TEMPERATURE_OUTLINE=0.3

# 幻灯片代码生成温度；越高越有创意但不稳定风险上升
LLM_TEMPERATURE_SLIDE=0.6

# 生成引擎：agentic_v2（推荐）或 legacy（旧流程）
GENERATION_ENGINE=agentic_v2

# run 存储后端：memory（内存，重启会丢失）或 postgres（持久化，推荐）
DIEGO_RUN_STORE=memory

# 当 DIEGO_RUN_STORE=postgres 时必填
# DIEGO_DATABASE_URL=postgresql://postgres:postgres@diego-postgres:5432/diego

# 启动时是否扫描并恢复中断 run：1=开启，0=关闭
DIEGO_RECOVERY_SCAN_ON_BOOT=1

# 事件等待轮询间隔（秒，postgres store 使用）
DIEGO_EVENT_POLL_INTERVAL_SEC=0.5

# 并行生成 slide 页数上限；值越大越快，但更容易触发超时/限流
SLIDE_CONCURRENCY=6

# 单页生成失败时的重试次数
SLIDE_RETRY=2

# 是否启用 QA 与修复闭环：1=启用，0=关闭
QA_ENABLED=1

# 整体修复轮数（编译后全局修复循环）
REPAIR_ROUNDS=2

# 单页 agentic 修复最大轮数
MAX_SLIDE_REPAIR_ROUNDS=4

# 是否保留每页 preview.pptx 调试文件：1=保留，0=自动清理
DEBUG_KEEP_PREVIEWS=0

# 大纲超时重试次数（仅超时类错误）
OUTLINE_TIMEOUT_RETRIES=3

# 大纲超时重试退避秒数
OUTLINE_TIMEOUT_BACKOFF_SEC=1.5

# 是否启用大纲结构化输出（JSON Schema）
OUTLINE_STRUCTURED_OUTPUT=1

# 全局 LLM 并发闸门（所有大纲/slide/evaluate 请求共享）
LLM_REQUEST_CONCURRENCY=10

# 按阶段并发控制：build 阶段（生成 JS）并发上限
LLM_CONCURRENCY_BUILD=6

# 按阶段并发控制：evaluate/review 阶段并发上限
LLM_CONCURRENCY_EVALUATE=3

# 按阶段并发控制：repair 阶段并发上限
LLM_CONCURRENCY_REPAIR=2

# 每页每轮候选并发数（cand-01/02/03）；越大质量探索更多但请求量更高
SLIDE_CANDIDATE_WORKERS=1

# 超时重试退避抖动（秒），用于避免所有请求同一时刻重试风暴
LLM_TIMEOUT_JITTER_SEC=0.8

# 连续超时达到阈值后进入“压力模式”（自动收敛并发）
TIMEOUT_STREAK_DEGRADE_THRESHOLD=3

# 压力模式恢复窗口（秒）；超过该窗口会逐步退出压力模式
TIMEOUT_STREAK_RECOVER_WINDOW_SEC=120

# 是否清理模型响应里的 <think>...</think> 等推理标签（建议开启）
LLM_SANITIZE_THINK_TAGS=1

# JSON 解析失败时，自动让模型“按错误信息修复并重试”的次数
LLM_JSON_REPAIR_RETRY=1

# 单页连续出现致命错误时提前停止的轮数（避免无效循环 4 轮跑满）
SLIDE_FATAL_EARLY_STOP_ROUNDS=2

# 单次 run 的 LLM 总调用上限；0=按页数动态计算默认值
RUN_MAX_LLM_CALLS=0

# 失败时是否保留每页最后一个候选 JS 到 slides/failed 便于排查
KEEP_FAILED_CANDIDATE_JS=1

# 是否启用“编译前自动纠错层”（仅修正硬错误 API/契约，不改内容创意）
SLIDE_AUTO_CANONICALIZE=1

# 失败诊断里最多保留的 JS 行数（带行号）
SLIDE_DIAG_MAX_JS_LINES=260

# 失败诊断里 stderr/stdout 的最大字符数（防止提示词爆炸）
SLIDE_DIAG_MAX_STDERR_CHARS=12000

# preview 编译并发上限（与 slide 生成并发解耦，避免 Node 编译风暴）
PREVIEW_QA_CONCURRENCY=4

# 素材抓取并发上限（避免图片源限流）
ASSET_FETCH_CONCURRENCY=2

# 编译完成后的 QA/修复阶段总超时（秒）；防止 run 长时间卡在 COMPILING
QA_FINALIZE_TIMEOUT_SEC=300

# 外部编译 provider：none（默认，仅暴露 compile bundle）、local、pagevra
COMPILE_PROVIDER=none

# 当 COMPILE_PROVIDER=pagevra 时使用
PAGEVRA_BASE_URL=

# 单页预览是否优先通过 Pagevra 渲染；关闭时返回 Diego 本地 fallback preview
PAGEVRA_PREVIEW_ENABLED=0

# Pagevra preview 请求超时（秒）
PAGEVRA_PREVIEW_TIMEOUT_SEC=30

# Pagevra compile 请求超时（秒）
PAGEVRA_COMPILE_TIMEOUT_SEC=180

# Stratumind 检索服务地址（用于大纲阶段 RAG 检索）；留空则不启用 Diego 侧检索调用
STRATUMIND_BASE_URL=http://stratumind:8110

# Stratumind 请求超时（秒）
STRATUMIND_TIMEOUT_SECONDS=12

# 大纲阶段检索 Top-K（最终会与 target_slide_count 取较大值）
DIEGO_RAG_TOP_K=10

# 传给 LLM 的检索片段数量上限
DIEGO_RAG_CONTEXT_MAX_SNIPPETS=10

# 单条检索片段截断长度上限（字符）
DIEGO_RAG_CONTEXT_MAX_CHARS=700

# =========================
# 模板模式图片/图标素材配置
# =========================

# 素材来源：mock（本地占位图）、none（禁用）、auto、unsplash、pexels
ASSET_PROVIDER=pexels

# Unsplash 访问密钥（当 ASSET_PROVIDER=auto/unsplash 时使用）
UNSPLASH_ACCESS_KEY=

# Pexels 访问密钥（当 ASSET_PROVIDER=auto/pexels 时使用）
PEXELS_API_KEY=


# 素材下载超时时间（秒）
ASSET_TIMEOUT_SEC=20

# 素材下载失败重试次数
ASSET_MAX_RETRIES=2
